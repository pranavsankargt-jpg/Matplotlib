    "import matplotlib.pyplot as plt\n",
    "x=[1,2,3,4,5]\n",
    "y=[2,4,6,8,10]\n",
    "plt.title('Line Plot Example')\n",
    "plt.xlabel('X-axis')\n",
    "plt.ylabel('Y-axis')\n",
    "plt.xlim(1,10)\n",
    "plt.ylim(5,15)\n",
    "plt.plot(x,y)\n",
    "plt.show()\n",
    "plt.savefig(\"sample.png\")\n",
    "plt.show()"
